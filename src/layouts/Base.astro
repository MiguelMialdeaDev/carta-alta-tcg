---
import '../styles/global.css';
import { juegos, juegosVisibles, productos } from '../data/productos.js';
import { MARCA } from '../data/marca.js';
import { u, BASE } from '../lib/url.js';

const slugsValidos = productos.map((p) => p.slug);
const { title, description = 'Tienda de producto sellado de cartas. One Piece, Pokémon y accesorios.', activo = '' } = Astro.props;
---

<!doctype html>
<html lang="es" data-base={BASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Demo con contenido de muestra. Fuera de buscadores hasta que sea una tienda real. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5f19a1" />
    <link rel="icon" type="image/png" sizes="32x32" href={u('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={u('favicon-192.png')} />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <script is:inline set:html={`window.__SLUGS__ = ${JSON.stringify(slugsValidos)};`}></script>
    <script is:inline>
      (function () {
        const KEY = 'cardzadora-carro';
        const VALIDOS = new Set(window.__SLUGS__ || []);

        function leer() {
          let bruto;
          try {
            bruto = JSON.parse(localStorage.getItem(KEY)) || {};
          } catch (e) {
            bruto = {};
          }
          if (bruto === null || typeof bruto !== 'object' || Array.isArray(bruto)) bruto = {};

          const limpio = {};
          let sobraba = false;
          Object.keys(bruto).forEach(function (slug) {
            const n = Math.floor(Number(bruto[slug]));
            if (VALIDOS.has(slug) && Number.isFinite(n) && n > 0) limpio[slug] = n;
            else sobraba = true;
          });
          if (sobraba) {
            try { localStorage.setItem(KEY, JSON.stringify(limpio)); } catch (e) {}
          }
          return limpio;
        }

        function guardar(carro) {
          // Abierto desde el disco, o en ventana privada, esto puede fallar.
          try { localStorage.setItem(KEY, JSON.stringify(carro)); } catch (e) {}
          pintarContador();
          document.dispatchEvent(new CustomEvent('carro:cambio', { detail: carro }));
        }

        function unidades(carro) {
          return Object.values(carro).reduce(function (t, n) { return t + n; }, 0);
        }

        function pintarContador() {
          const n = unidades(leer());
          document.querySelectorAll('[data-cart-count]').forEach(function (el) {
            el.textContent = String(n);
          });
        }

        window.carro = {
          leer: leer,
          add: function (slug, cantidad, tope) {
            const carro = leer();
            const actual = carro[slug] || 0;
            const siguiente = Math.min(actual + (cantidad || 1), tope || 99);
            carro[slug] = siguiente;
            guardar(carro);
            return siguiente;
          },
          set: function (slug, cantidad) {
            const carro = leer();
            if (cantidad <= 0) delete carro[slug];
            else carro[slug] = cantidad;
            guardar(carro);
          },
          vaciar: function () {
            try { localStorage.removeItem(KEY); } catch (e) {}
            pintarContador();
            document.dispatchEvent(new CustomEvent('carro:cambio', { detail: {} }));
          },
        };

        document.addEventListener('DOMContentLoaded', pintarContador);
        pintarContador();
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#principal">Saltar al contenido</a>

    <p class="demo-bar">
      <strong>Bienvenido a CardZadora.</strong> Producto sellado y precintado, enviado a península.<span class="solo-ancho"> Escríbenos si buscas algo que no ves en la tienda.</span>
    </p>

    <header class="nav">
      <nav class="wrap nav-inner" aria-label="Principal">
        <a class="wordmark" href={u()}>
          <img src={u(MARCA.isotipo)} width="35" height="34" alt="" />
          <span>{MARCA.palabra.antes}<span class="z">{MARCA.palabra.letra}</span>{MARCA.palabra.despues}</span>
        </a>
        <a class="nav-cart" href={u('carrito/')} aria-label="Carrito">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.55L20.5 8H6.2"
              fill="none" stroke="currentColor" stroke-width="1.9"
              stroke-linecap="round" stroke-linejoin="round"
            />
            <circle cx="10" cy="19.5" r="1.4" fill="currentColor" />
            <circle cx="17" cy="19.5" r="1.4" fill="currentColor" />
          </svg>
          <span class="texto">Carrito</span>
          <span class="cart-count" data-cart-count>0</span>
        </a>

        <button
          class="nav-menu"
          type="button"
          data-menu-boton
          aria-expanded="false"
          aria-controls="menu-categorias"
          aria-label="Categorías"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" data-icono="abrir">
            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" data-icono="cerrar" hidden>
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>

        <ul class="nav-games" id="menu-categorias">
          <li><a href={u('tienda/')} aria-current={activo === 'tienda' ? 'page' : undefined}>Todo</a></li>
          {juegosVisibles.map((j) => (
            <li>
              <a href={u(`tienda/${j.slug}/`)} aria-current={activo === j.slug ? 'page' : undefined}>
                {j.nombre}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <script is:inline>
      // El menu arranca ABIERTO en el HTML y lo cierra este script. Asi, si el
      // JavaScript no llega, las categorias siguen estando ahi y accesibles.
      (function () {
        const boton = document.querySelector('[data-menu-boton]');
        const lista = document.getElementById('menu-categorias');
        if (!boton || !lista) return;

        const abrir = boton.querySelector('[data-icono="abrir"]');
        const cerrar = boton.querySelector('[data-icono="cerrar"]');

        // El estado va en la cabecera, no como atributo hidden en la lista: en
        // escritorio la lista se ve siempre y un hidden ahi seria mentira para
        // los lectores de pantalla.
        const barra = boton.closest('.nav');

        function poner(abierto) {
          boton.setAttribute('aria-expanded', String(abierto));
          barra.dataset.menu = abierto ? 'abierto' : 'cerrado';
          // Con setAttribute y no con .hidden: los SVG no son elementos HTML y
          // no tienen esa propiedad, asi que asignarla no cambia nada.
          abrir.toggleAttribute('hidden', abierto);
          cerrar.toggleAttribute('hidden', !abierto);
        }

        poner(false);

        boton.addEventListener('click', function (e) {
          e.stopPropagation();
          poner(boton.getAttribute('aria-expanded') !== 'true');
        });

        document.addEventListener('click', function (e) {
          if (boton.getAttribute('aria-expanded') !== 'true') return;
          if (lista.contains(e.target) || boton.contains(e.target)) return;
          poner(false);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          if (boton.getAttribute('aria-expanded') !== 'true') return;
          poner(false);
          boton.focus();
        });
      })();
    </script>

    <main id="principal">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <p class="foot-statement">Producto sellado, bien protegido y enviado con cuidado.</p>
        <div class="foot-meta">
          <span>{MARCA.nombre}</span>
          <a href={u('tienda/')}>Tienda</a>
          <a href={`mailto:${MARCA.email}`}>{MARCA.email}</a>
          <span class="todo">aquí van los datos fiscales</span>
          <span class="todo">aviso legal y condiciones de compra</span>
        </div>
      </div>
    </footer>

  </body>
</html>
