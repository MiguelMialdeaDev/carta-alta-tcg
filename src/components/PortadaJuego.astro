---
// Portada de categoría dibujada a mano, para las categorías que todavía no
// tienen foto real. No es un packshot suelto centrado en el marco: es una
// composición que llena el 16:9, con varias piezas superpuestas, para que la
// tarjeta se vea acabada y no a medias.
//
// Sigue siendo un dibujo. En cuanto la tienda mande una foto de esa categoría,
// el componente deja de usarse solo: manda la foto.
const { mark = 'var(--color-brand)', escena = 'cajas' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<svg
  viewBox="0 0 320 180"
  preserveAspectRatio="xMidYMid slice"
  style={`width: 100%; height: 100%; display: block; --mark: ${mark};`}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`f-${uid}`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0%" stop-color="var(--mark)" stop-opacity="0.16" />
      <stop offset="100%" stop-color="var(--mark)" stop-opacity="0.04" />
    </linearGradient>
    <linearGradient id={`c-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--mark)" stop-opacity="0.42" />
      <stop offset="100%" stop-color="var(--mark)" stop-opacity="0.16" />
    </linearGradient>
  </defs>

  <rect width="320" height="180" fill={`url(#f-${uid})`} />

  {escena === 'cajas' && (
    <g stroke="var(--mark)" stroke-opacity="0.6" stroke-width="1.6" fill={`url(#c-${uid})`}>
      {/* cartas en abanico, al fondo a la izquierda */}
      <g stroke-opacity="0.4">
        <rect x="24" y="66" width="46" height="66" rx="4" transform="rotate(-14 47 99)" />
        <rect x="38" y="62" width="46" height="66" rx="4" transform="rotate(-5 61 95)" />
        <rect x="54" y="60" width="46" height="66" rx="4" transform="rotate(4 77 93)" />
      </g>

      {/* la caja expositora, la pieza principal */}
      <rect x="112" y="62" width="104" height="82" rx="5" />
      <rect x="112" y="48" width="104" height="20" rx="5" fill="var(--mark)" fill-opacity="0.5" />
      <line x1="164" y1="70" x2="164" y2="138" stroke-opacity="0.35" />

      {/* un sobre apoyado a la derecha */}
      <rect x="238" y="58" width="52" height="86" rx="3" />
      <line x1="244" y1="70" x2="284" y2="70" stroke-dasharray="4 4" stroke-opacity="0.5" />
    </g>
  )}

  {escena === 'accesorios' && (
    <g stroke="var(--mark)" stroke-opacity="0.6" stroke-width="1.6" fill={`url(#c-${uid})`}>
      {/* tapete enrollado */}
      <g stroke-opacity="0.4">
        <rect x="20" y="74" width="66" height="52" rx="16" transform="rotate(-8 53 100)" />
      </g>

      {/* carpeta abierta */}
      <rect x="104" y="50" width="110" height="94" rx="6" />
      <line x1="159" y1="50" x2="159" y2="144" stroke-opacity="0.4" />
      <g stroke-opacity="0.35">
        <line x1="116" y1="72" x2="148" y2="72" />
        <line x1="116" y1="92" x2="148" y2="92" />
        <line x1="116" y1="112" x2="148" y2="112" />
        <line x1="170" y1="72" x2="202" y2="72" />
        <line x1="170" y1="92" x2="202" y2="92" />
        <line x1="170" y1="112" x2="202" y2="112" />
      </g>

      {/* taco de fundas */}
      <rect x="236" y="66" width="58" height="78" rx="4" />
      <line x1="236" y1="80" x2="294" y2="80" stroke-opacity="0.45" />
      <line x1="236" y1="88" x2="294" y2="88" stroke-opacity="0.45" />
    </g>
  )}
</svg>
