---
import Base from '../layouts/Base.astro';
import CardProducto from '../components/CardProducto.astro';
import { productos, juegos, ENVIO, eur, portadaDe } from '../data/productos.js';
import PortadaJuego from '../components/PortadaJuego.astro';
import Foto from '../components/Foto.astro';
import { MARCA } from '../data/marca.js';
import { u } from '../lib/url.js';

const destacados = productos.filter((p) => p.destacado).slice(0, 4);
const portadas = Object.fromEntries(juegos.map((j) => [j.slug, portadaDe(j.slug)]));
const cuenta = (slug) => productos.filter((p) => p.juego === slug).length;
---

<Base title={`${MARCA.nombre} · ${MARCA.claim}`} activo="home">
  <section class="wrap hero">
    <h1>Cartas selladas, enviadas en 24 horas</h1>
    <p class="lede">
      Sobres, cajas y mazos de Pokémon, Magic, One Piece y Naruto. Todo precintado y guardado en almacén propio.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={u('tienda/')}>Ver la tienda</a>
      <a class="btn btn-ghost" href="#juegos">Buscar por juego</a>
    </div>
  </section>

  <section class="wrap band-tight" id="juegos" aria-label="Explorar la tienda">
    <div class="bento">
      <div class="cell span-2 reveal">
        <span class="stat-num">24 h</span>
        <h2>Sale el mismo día</h2>
        <p>
          Pedidos antes de las 17:00 salen ese día. Envío {eur(ENVIO.coste)} a {ENVIO.zona} y gratis a partir de {eur(ENVIO.gratisDesde)}.
        </p>
        <a class="cell-link" href={u('tienda/')}>Empezar a comprar</a>
      </div>

      <div class="cell span-2 reveal">
        <h2>Detrás del mostrador hay una persona</h2>
        <p>
          Te atiende quien prepara los pedidos. Si tienes dudas con una expansión o un idioma, pregunta antes de comprar.
        </p>
        <p><span class="todo">aquí va tu foto y tu nombre</span></p>
      </div>

      {juegos.map((j) => (
        <a class="cell cell-game reveal" style={`--mark: ${j.mark};`} href={u(`tienda/${j.slug}/`)}>
          <span class="cell-game-media" aria-hidden="true">
            {portadas[j.slug].tipo === 'foto'
              ? <Foto foto={{ ...portadas[j.slug].foto, alt: '' }} ratio="16 / 9" />
              : <PortadaJuego mark={j.mark} escena={portadas[j.slug].escena} />}
          </span>
          <span class="cell-game-texto">
            <h3>{j.nombre}</h3>
            <span class="count">{cuenta(j.slug)} referencias</span>
          </span>
        </a>
      ))}

      <div class="cell span-2 reveal">
        <h2>Aquí solo hay producto sellado</h2>
        <p>
          Cajas, displays, mazos y sobres precintados de fábrica. No vendemos cartas sueltas ni producto abierto, así que lo que ves en la ficha es lo que llega a tu casa.
        </p>
        <a class="cell-link" href={u('tienda/')}>Ver el catálogo</a>
      </div>

      <div class="cell reveal">
        <h3>El idioma va en la ficha</h3>
        <p>Hay producto en español y en inglés. Lo dice cada ficha, para que no te lleves la sorpresa al abrir la caja.</p>
      </div>
    </div>
  </section>

  <section class="wrap band">
    <div class="section-head">
      <h2>Lo que más se mueve</h2>
      <p>Una selección corta del catálogo.</p>
    </div>
    <ul class="grid-products">
      {destacados.map((p) => <CardProducto producto={p} />)}
    </ul>
  </section>

  <section class="wrap band-tight">
    <div class="split-2">
      <div>
        <div class="section-head">
          <h2>Antes de que preguntes</h2>
        </div>
        <dl class="spec">
          <dt>Envío</dt>
          <dd>{eur(ENVIO.coste)} a {ENVIO.zona}. Gratis desde {eur(ENVIO.gratisDesde)}. Fuera de {ENVIO.zona} todavía no llegamos.</dd>
          <dt>Plazo</dt>
          <dd>Entrega en 24 o 48 horas según la zona.</dd>
          <dt>Devoluciones</dt>
          <dd><span class="todo">tu política, palabra por palabra</span></dd>
        </dl>
      </div>
      <div class="panel">
        <h3>¿Buscas algo que no está?</h3>
        <p style="color: var(--color-ink-2); font-size: var(--text-sm); margin-block: var(--space-xs) var(--space-md);">
          Escríbenos y te decimos si podemos conseguirlo y a qué precio.
        </p>
        <a class="btn btn-brand" href={`mailto:${MARCA.email}`}>Escribir a {MARCA.email}</a>
      </div>
    </div>
  </section>
</Base>
