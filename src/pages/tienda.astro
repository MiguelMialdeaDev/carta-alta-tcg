---
import Base from '../layouts/Base.astro';
import Rejilla from '../components/Rejilla.astro';
import { productos } from '../data/productos.js';
import { titulo } from '../data/marca.js';
---

<Base title={titulo('Tienda')} activo="tienda">
  <section class="wrap band-tight">
    <div class="section-head">
      <h1 style="font-size: var(--text-display-s);">Tienda</h1>
      <p>Producto sellado con stock real. Aquí no vendemos cartas sueltas.</p>
    </div>
    <Rejilla productos={productos} />
  </section>

  <script is:inline>
    // Enlaces antiguos del tipo /tienda/?juego=pokemon. Ahora cada juego tiene página propia.
    (function () {
      const juego = new URLSearchParams(location.search).get('juego');
      if (!juego || !/^[a-z-]+$/.test(juego)) return;
      const base = document.documentElement.dataset.base || '/';
      location.replace(base + 'tienda/' + juego + '/');
    })();
  </script>
</Base>
